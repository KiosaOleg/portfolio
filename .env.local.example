# GitHub Configuration
# 1. Go to https://github.com/settings/tokens
# 2. Generate a new token (classic) with scopes:
#    - public_repo (public repos)
#    - repo (optional, for private collaborator repos)
# 3. Copy the token here
GITHUB_TOKEN=your_github_token_here

# Your GitHub username (must match the token owner)
GITHUB_USERNAME=your_github_username

# Set to "false" to hide collaborator repositories
# GITHUB_INCLUDE_COLLABORATOR=true
